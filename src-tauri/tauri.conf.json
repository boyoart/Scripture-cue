{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Scripture Cue",
    "version": "0.2.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.scripturecue.app",
      "icon": [
        "icons/icon.ico"
      ]
    },
    "windows": [
      {
        "title": "Scripture Cue",
        "width": 1320,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
